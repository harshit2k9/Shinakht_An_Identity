rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin-only collections (Blocked from clients; Python backend uses Admin SDK)
    match /pairingCodes/{doc} {
      allow read, write: if false;
    }
    match /pairingAttempts/{doc} {
      allow read, write: if false;
    }

    // Users: Allow users to read/write their own user document during registration & app use
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Patients
    match /patients/{pid} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() 
        && request.auth.uid == pid 
        && request.resource.data.caregivers is list 
        && request.resource.data.caregivers.size() == 0;
      
      allow update: if isAuthenticated() && (
        (request.auth.uid == pid && 
         request.resource.data.diff().affectedKeys().hasOnly(['name', 'safeZone', 'lastLocation', 'battery', 'lastSeen'])) ||
        (request.resource.data.diff().affectedKeys().hasOnly(['safeZone']) && 
         resource.data.caregivers.hasAny([request.auth.uid]))
      );
      allow delete: if false;

      match /alerts/{id} {
        allow read: if isAuthenticated() && (request.auth.uid == pid || resource.data.caregivers.hasAny([request.auth.uid]));
        allow create: if isAuthenticated() && request.auth.uid == pid;
        allow update: if isAuthenticated() 
          && resource.data.caregivers.hasAny([request.auth.uid])
          && request.resource.data.diff().affectedKeys().hasOnly(['ackedBy', 'ackedAt']);
        allow delete: if false;
      }

      match /sessions/{id} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == pid;
        allow delete: if false;
      }
      match /daily/{date} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /reminders/{id} {
        allow read: if isAuthenticated() && request.auth.uid == pid;
        allow write: if isAuthenticated(); 
      }
      match /contacts/{id} {
        allow read: if isAuthenticated() && request.auth.uid == pid;
        allow write: if isAuthenticated();
      }
    }

    // Request Docs
    match /pairingRequests/{id} {
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'type', 'createdAt'])
        && request.resource.data.type == 'create';
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /linkRequests/{id} {
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'code', 'createdAt']);
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /assistantRequests/{id} {
      allow create: if isAuthenticated() 
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'text', 'language', 'history', 'createdAt']);
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Secure by default for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}